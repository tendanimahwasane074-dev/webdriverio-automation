# Copy to device.env (gitignored) and fill in for your own iPhone.
# UDID:     xcrun xctrace list devices
# Team ID:  codesign -dvv apps/ios_device/wdiodemoapp.app 2>&1 | grep TeamIdentifier
IOS_DEVICE_UDID=
IOS_XCODE_ORG_ID=
IOS_XCODE_SIGNING_ID="Apple Development"
IOS_WDA_BUNDLE_ID=com.yourname.webdriveragent
# Bundle ID of your signed device build: codesign -dvv apps/ios_device/wdiodemoapp.app 2>&1 | grep ^Identifier
IOS_BUNDLE_ID=
