{
  "name": "capitec-wdio-appium",
  "version": "1.0.0",
  "description": "WebdriverIO + Appium Cucumber/TypeScript automation against the WebdriverIO native demo app, with shared step definitions across Android and iOS.",
  "main": "index.js",
  "scripts": {
    "test:android": "./scripts/run-with-log.sh android env PLATFORM=android wdio run ./wdio.conf.ts",
    "test:ios": "./scripts/run-with-log.sh ios env PLATFORM=ios wdio run ./wdio.conf.ts",
    "test:ios:device": "./scripts/run-with-log.sh ios-device env PLATFORM=ios-device wdio run ./wdio.conf.ts",
    "test": "npm run test:ios",
    "postinstall": "node scripts/apply-allure-branding.cjs",
    "report:generate": "node scripts/apply-allure-branding.cjs && allure generate reports/allure-results --clean -o reports/allure-report --name \"Capitec Mobile Automation Results\"",
    "report:open": "allure open reports/allure-report",
    "report": "npm run report:generate && npm run report:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@types/node": "^26.6.6",
    "@wdio/allure-reporter": "^10.1.0",
    "@wdio/cli": "^10.1.0",
    "@wdio/cucumber-framework": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@wdio/types": "^10.1.0",
    "allure-commandline": "^2.46.1",
    "expect-webdriverio": "^8.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "webdriverio": "^10.1.0"
  }
}
